<iframe src="https://www.example.com" width="48%" height="350" allow="fullscreen; gyroscope; usb" title="Version B - All Three Permissions" style="border:none;"></iframe>

Q30
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Best Practice Iframes</title>
<style>iframe{border:none; width:100%; border-radius:8px; margin-bottom:20px;}</style>
</head>
<body>
<h1>Iframe Best Practices Demo</h1>

<!-- Normal webpage, no special permissions needed, most secure -->
<iframe src="https://www.example.com" height="300" title="General Website - No Special Permissions"></iframe>

<!-- Video that needs fullscreen and gyroscope for 360 view -->
<iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" height="315" allow="fullscreen; gyroscope" allowfullscreen title="Video Player - Needs Fullscreen and Gyroscope"></iframe>

<!-- Device panel that needs USB access -->
<iframe src="https://device.example.com" height="400" allow="usb" title="Device Panel - Needs USB Access"></iframe>
</body>
</html> 
